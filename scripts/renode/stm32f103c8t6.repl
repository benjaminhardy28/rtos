// STM32F103C8T6 ("Blue Pill"): 64K flash / 20K RAM.
//
// Flash and SRAM sit at their real hardware addresses (0x08000000 /
// 0x20000000), matching linker/stm32f103c8t6.ld exactly -- unlike
// stm32f103.repl's high-density variant, which maps flash at 0x0 to
// match a linker script that relies on the BOOT0 alias. Keeping the
// same addresses in the emulator and on real silicon means an image
// built for this board runs identically in both places.
//
// Same "headless, minimal platform" convention as stm32f103.repl -- no
// UART/GPIO/timers wired up beyond what this RTOS currently uses.

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x00010000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00005000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    // Matches kernel/task.c's hardcoded `systick_init(25000000u, ...)`
    // call rather than real STM32F103 hardware's 72MHz max -- if you
    // change one, change the other, or ticks will fire at the wrong rate.
    systickFrequency: 25000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

// Backs DWT_CYCCNT (bench/bench_clock.c), same as stm32f103.repl.
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 25000000

// bxCAN, 4 IRQ lines (TX, RX0, RX1, SCE) at their real NVIC positions.
// No driver exists yet in this RTOS -- this just makes the peripheral
// present and pokeable via GDB/the Renode monitor.
can1: CAN.STMCAN @ sysbus <0x40006400, +0x400>
    [0-3] -> nvic@[19-22]
