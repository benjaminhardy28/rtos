// Minimal Cortex-M3 platform matching linker/mps2-an385.ld and the real
// ARM MPS2+ AN385 memory map (no UART/GPIO peripherals: this RTOS is
// currently headless and communicates state through memory that GDB /
// the Renode monitor can read directly).
//
// Combined FLASH region covers FLASH_USER (0x00000000, 256K) +
// FLASH_KERNEL (0x00040000, 256K) from the linker script.
flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

// Combined RAM region covers RAM_USER (0x20000000, 128K) +
// RAM_KERNEL (0x20020000, 128K) from the linker script.
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00040000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 25000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

// Backs DWT_CYCCNT (bench/bench_clock.c) with a real, incrementing cycle
// counter. QEMU's mps2-an385 model has no DWT at all, so this register
// always reads 0 there -- Renode is what makes bench/ usable.
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 25000000
