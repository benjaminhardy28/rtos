// STM32F103 (Cortex-M3), "high-density" line (512K flash / 64K RAM,
// matching e.g. STM32F103VE/ZE) -- sized to match linker/stm32f103.ld,
// see that file for why this variant was picked over the smaller
// "Blue Pill" C8T6.
//
// Trimmed to just what this RTOS uses today, following the same
// "headless, minimal platform" convention as mps2-an385.repl (no
// UART/GPIO/timers wired up -- add them here if/when drivers exist).
//
// CAN.STMCAN isn't in Renode's bundled stm32f103.repl, but it's the
// same peripheral model stm32f4.repl/stm32g0.repl use, at the same
// 0x40006400 bxCAN address real STM32F103 hardware has, so it's added
// manually below.

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00010000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    // Matches kernel/task.c's hardcoded `systick_init(25000000u, ...)`
    // call rather than real STM32F103 hardware's 72MHz max -- if you
    // change one, change the other, or ticks will fire at the wrong rate.
    systickFrequency: 25000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

// Backs DWT_CYCCNT (bench/bench_clock.c), same as mps2-an385.repl.
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 25000000

// bxCAN, 4 IRQ lines (TX, RX0, RX1, SCE) at their real NVIC positions.
// No driver exists yet in this RTOS -- this just makes the peripheral
// present and pokeable via GDB/the Renode monitor.
can1: CAN.STMCAN @ sysbus <0x40006400, +0x400>
    [0-3] -> nvic@[19-22]
